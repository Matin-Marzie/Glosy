# reels-service/.env is git-ignored; never commit real credentials.

# Server
PORT=3600
DEBUG=true

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=thesis_db
DB_USER=root
DB_PASSWORD=1234
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_SSL=false

# Recommendation engine
COMPREHENSIBILITY_THRESHOLD=0.98
RECENTLY_VIEWED_COOLDOWN_HOURS=24

# JWT (must match ACCESS_TOKEN_SECRET in backend/.env)
ACCESS_TOKEN_SECRET=

# Object storage (same values as backend/.env)
CDN_ENDPOINT=
CDN_ACCESS_KEY_ID=
CDN_SECRET_ACCESS_KEY=
CDN_BUCKET_NAME=
CDN_PUBLIC_URL=
