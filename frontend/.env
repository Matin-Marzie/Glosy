# /frontend/.env is git-ignored; never commit real credentials.

# Backend API and reels service
EXPO_PUBLIC_BACKEND_URL=http://COMPUTER_IP_ADDRESS:3500
EXPO_PUBLIC_REELS_RECOMMENDATION_URL=http://COMPUTER_IP_ADDRESS:3600

# Public URL of the object storage bucket (same as CDN_PUBLIC_URL in backend/.env)
EXPO_PUBLIC_CDN_URL=

# Google Sign-In (OAuth client IDs)
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=
GOOGLE_CLIENT_ID_IOS=
