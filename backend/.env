# backend/.env is git-ignored; never commit real credentials.

# Server
PORT=3500
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=thesis_db
DB_USER=root
DB_PASSWORD=1234
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_SSL=false

# JWT (use long random strings)
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRES_IN=1h
REFRESH_TOKEN_ABSOLUTE_DAYS=90

# Email verification and password reset codes (expiry in minutes)
EMAIL_VERIFICATION_SECRET=
EMAIL_VERIFICATION_CODE_EXPIRES_IN=10
PASSWORD_RESET_SECRET=
PASSWORD_RESET_CODE_EXPIRES_IN=10

# SMTP (outgoing email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Google Sign-In (OAuth client IDs)
GOOGLE_CLIENT_ID_WEB=
GOOGLE_CLIENT_ID_IOS=

# Object storage (S3-compatible, e.g. Cloudflare R2) for media
CDN_ENDPOINT=
CDN_ACCESS_KEY_ID=
CDN_SECRET_ACCESS_KEY=
CDN_BUCKET_NAME=
CDN_PUBLIC_URL=

# Game
MAX_ENERGY=5
